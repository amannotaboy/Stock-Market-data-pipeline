# Copy to .env. Do not put real credentials in this example file.
AIRFLOW_FERNET_KEY=
AIRFLOW_DATABASE_URL=postgresql+psycopg2://postgres:URL_ENCODED_PASSWORD@host.docker.internal:5432/airflow
STOCK_STATE_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@host.docker.internal:5432/stock_pipeline

DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_API_VERSION=2026-07-23
DATE_HEADER=X-Aux-Date
DNSE_SYMBOLS=ACB,BCM,BID,BVH,CTG,FPT,GAS,GVR,HDB,HPG,MBB,MSN,MWG,PLX,POW,SAB,SHB,SSB,SSI,STB,TCB,TPB,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VRE
DNSE_INDEX_SYMBOLS=VNINDEX,VN30
DNSE_RESOLUTION=1
# Separate market-wide topic: daily candles and market breadth.
# Zero means all discovered symbols matching the filters. Set a positive cap for pilots.
DNSE_MARKET_MAX_SYMBOLS=0
DNSE_MARKET_RESOLUTION=1
DNSE_MARKET_LOOKBACK_DAYS=1
DNSE_INSTRUMENT_PAGE_SIZE=100
DNSE_INSTRUMENT_MAX_PAGES=30
DNSE_MARKET_SYMBOL_REGEX=^[A-Z][A-Z][A-Z]$
DNSE_MARKET_STOCK_GROUP_IDS=ST
DNSE_REQUEST_DELAY_SECONDS=0.15
# Optional comma-separated override. Leave blank to discover symbols from paginated instrument data.
DNSE_MARKET_SYMBOLS=
AIRFLOW_UID=50000
